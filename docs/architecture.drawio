        </mxCell>
        <mxCell id="seq_service" value="UserService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="seq_repo" value="UserRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="120" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="seq_jwt" value="JwtUtil" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#e53935;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="90" height="50" as="geometry" />
        </mxCell>
        <!-- Messages as edges -->
        <mxCell id="seq_edge_1" value="POST /auth/login" edge="1" parent="1" source="seq_user" target="seq_controller" style="endArrow=classic;strokeColor=#000000;" />
        <mxCell id="seq_edge_2" value="authenticate()" edge="1" parent="1" source="seq_controller" target="seq_service" style="endArrow=classic;strokeColor=#000000;" />
        <mxCell id="seq_edge_3" value="findByEmail()" edge="1" parent="1" source="seq_service" target="seq_repo" style="endArrow=classic;strokeColor=#000000;" />
        <mxCell id="seq_edge_4" value="User" edge="1" parent="1" source="seq_repo" target="seq_service" style="endArrow=classic;strokeColor=#000000;dashed=1;" />
        <mxCell id="seq_edge_5" value="generateToken()" edge="1" parent="1" source="seq_service" target="seq_jwt" style="endArrow=classic;strokeColor=#000000;" />
        <mxCell id="seq_edge_6" value="JWT" edge="1" parent="1" source="seq_jwt" target="seq_service" style="endArrow=classic;strokeColor=#000000;dashed=1;" />
        <mxCell id="seq_edge_7" value="LoginResponse" edge="1" parent="1" source="seq_service" target="seq_controller" style="endArrow=classic;strokeColor=#000000;" />
        <mxCell id="seq_edge_8" value="200 OK + JWT" edge="1" parent="1" source="seq_controller" target="seq_user" style="endArrow=classic;strokeColor=#000000;" />
      </root>
